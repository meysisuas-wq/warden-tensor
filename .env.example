# WardenTensor Configuration
APP_NAME=WardenTensor
APP_ENV=development
APP_DEBUG=true
APP_PORT=8002
APP_SECRET_KEY=change-me

DATABASE_URL=postgresql+asyncpg://warden:password@localhost:5432/wardentensor
DATABASE_POOL_SIZE=25

REDIS_URL=redis://localhost:6379/2

ROCM_ENABLED=false
ROCM_DEVICE_ID=0
INFERENCE_BATCH_SIZE=8

MAX_STREAMS=100
STREAM_BUFFER_SIZE=30
FRAME_SKIP=2

CONFIDENCE_THRESHOLD=0.65
NMS_THRESHOLD=0.45

ALERT_COOLDOWN_SECONDS=30
MAX_ALERTS_PER_MINUTE=100

LOG_LEVEL=INFO
